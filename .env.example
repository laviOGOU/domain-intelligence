# ============================================================================
#  DOMAIN INTELLIGENCE — configuration
#  Copie ce fichier en « .env » (même dossier que app.py) et remplis les valeurs.
#  Le fichier .env ne doit jamais être partagé ni versionné.
# ============================================================================

# --- Supabase (optionnel) ---------------------------------------------------
# Où les trouver : ton projet Supabase → Settings → API
#   SUPABASE_URL = "Project URL"      (ex. https://abcdefgh.supabase.co)
#   SUPABASE_KEY = clé "anon public"
# Sans ces deux lignes, l'application bascule automatiquement sur un stockage
# local (storage/history.json) : tout le reste fonctionne normalement.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=domain_analyses

# Clé de secours : utilisée UNIQUEMENT si la RLS refuse la clé anon.
# Elle contourne toutes les règles de sécurité : à réserver au dépannage local.
# À supprimer dès que les politiques RLS de supabase_setup.sql sont en place.
SUPABASE_SERVICE_KEY=

# Jeton personnel, uniquement pour init_supabase.py (exécution du SQL).
# À créer sur https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Serveur web ------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=5001
APP_DEBUG=0

# --- API externes (aucune clé nécessaire) -----------------------------------
RDAP_ENDPOINT=https://rdap.org/domain/{domain}
IP_API_ENDPOINT=http://ip-api.com/json/{ip}
HTTP_TIMEOUT=15

# --- Seuils de risque (score sur 100) ---------------------------------------
RISK_MEDIUM_THRESHOLD=25
RISK_HIGH_THRESHOLD=55
