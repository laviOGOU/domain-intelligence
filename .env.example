# ============================================================================
#  DOMAIN INTELLIGENCE — configuration
#  Copie ce fichier en « .env » (même dossier que app.py) et remplis les valeurs.
#  Le fichier .env ne doit jamais être partagé ni versionné.
# ============================================================================

# --- Supabase (optionnel) ---------------------------------------------------
# Où les trouver : ton projet Supabase → Settings → API
#   SUPABASE_URL = "Project URL"      (ex. https://abcdefgh.supabase.co)
#   SUPABASE_KEY = clé "anon public"
# Sans ces deux lignes, l'application bascule automatiquement sur un stockage
# local (storage/history.json) : tout le reste fonctionne normalement.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=domain_analyses

# Clé de secours : utilisée UNIQUEMENT si la RLS refuse la clé anon.
# Elle contourne toutes les règles de sécurité : à réserver au dépannage local.
# À supprimer dès que les politiques RLS de supabase_setup.sql sont en place.
SUPABASE_SERVICE_KEY=

# Jeton personnel, uniquement pour init_supabase.py (exécution du SQL).
# À créer sur https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Serveur web ------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=5001
APP_DEBUG=0

# --- Sources de données ------------------------------------------------------
#
# DEUX CATÉGORIES, VOLONTAIREMENT SÉPARÉES
#
#   * SANS CLÉ — le fournisseur est interrogé directement, sans compte. Ces
#     sources fonctionnent dès l'installation et suffisent à produire une
#     analyse complète.
#
#   * AVEC CLÉ — facultatives. Sans clé, la source est simplement absente de la
#     fiche et signalée comme telle dans « ce que cette analyse ne permet pas
#     d'affirmer ». Jamais de résultat inventé pour combler le vide.
#
# Toutes sont des services reconnus, et chacune répond à une question précise.

# --- Registre des noms de domaine : RDAP (norme ICANN) ----------------------
# Source officielle : les registres régionaux publient eux-mêmes ces données.
# Aucune clé. Aucun quota.
RDAP_ENDPOINT=https://rdap.org/domain/{domain}

# --- Résolution DNS par résolveurs publics (HTTPS) --------------------------
# Remplace le résolveur du système d'exploitation, dont la réponse dépendait de
# la machine et pouvait donc varier d'un utilisateur à l'autre.
DOH_CLOUDFLARE=https://cloudflare-dns.com/dns-query
DOH_GOOGLE=https://dns.google/resolve

# --- Adresses IP : propriétaire officiel et localisation --------------------
# RDAP pour les IP donne le titulaire enregistré du bloc (fait de registre).
# IPinfo donne la localisation estimée. Sans jeton, IPinfo fonctionne en usage
# réduit ; un jeton gratuit (https://ipinfo.io/signup) lève la limite.
RDAP_IP_ENDPOINT=https://rdap.org/ip/{ip}
IPINFO_ENDPOINT=https://ipinfo.io/{ip}/json
IPINFO_TOKEN=

# --- Note de configuration TLS : Qualys SSL Labs ----------------------------
# La référence du secteur pour noter un serveur de A+ à F. Sans clé.
# L'analyse prend de quelques secondes à une minute selon que le domaine a déjà
# été noté récemment. SSLLABS_MAX_WAIT borne l'attente ; 0 désactive la source.
SSLLABS_ENDPOINT=https://api.ssllabs.com/api/v3/analyze
SSLLABS_MAX_WAIT=45

# --- Réputation : VirusTotal -------------------------------------------------
# Facultatif. Agrège le verdict de plus de 70 moteurs de sécurité. C'est la
# source la plus parlante d'une fiche, et la seule à confirmer un danger.
# Clé gratuite (500 requêtes/jour, 4/minute) :
#   https://www.virustotal.com/gui/join-us  →  Profil → API key
VIRUSTOTAL_KEY=

# --- Sous-domaines : journaux publics de certificats ------------------------
# Service gratuit et « au mieux » : il répond souvent en erreur quand il est
# surchargé. L'absence de résultat est signalée comme telle, jamais comme
# l'absence de sous-domaines.
CRTSH_ENDPOINT=https://crt.sh/

# --- Réputation observée : urlscan.io ---------------------------------------
# Sans clé en lecture. Une clé gratuite (https://urlscan.io/user/signup) relève
# les quotas de recherche.
URLSCAN_ENDPOINT=https://urlscan.io/api/v1/search/

# --- Réglages réseau --------------------------------------------------------
HTTP_TIMEOUT=15
USER_AGENT=domain-intelligence/1.1 (+https://github.com/laviOGOU/domain-intelligence)

# --- Seuils de risque (score sur 100) ---------------------------------------
RISK_MEDIUM_THRESHOLD=25
RISK_HIGH_THRESHOLD=55
